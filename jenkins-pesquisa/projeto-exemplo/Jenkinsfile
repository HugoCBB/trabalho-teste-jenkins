
pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/USUARIO/projeto-exemplo.git', branch: 'main'
            }
        }
        stage('Testes') {
            steps {
                sh '''
                    python3 -m venv venv
                    . venv/bin/activate
                    pip install -q -r requirements.txt
                    pytest --junitxml=resultados.xml || true
                '''
            }
        }
    }
    post {
        always {
            junit 'resultados.xml'  
        }
    }
}
